+    low = 0;
+  for (let i = 0; i < samples.length; i++) {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    const white = (seed / 0xffffffff) * 2 - 1;
+    low = low * 0.975 + white * 0.025;
+    samples[i] = low * 2.4 + white * 0.06;
+  }
