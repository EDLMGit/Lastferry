+    await idle(page);
+    const completed = await page.evaluate(() => ({
+      transition: window.__LAST_FERRY__.getTransitionStatus(),
+      state: window.__LAST_FERRY__.getState(),
+      environment: window.__LAST_FERRY__.getEnvironmentStatus(),
+    }));
