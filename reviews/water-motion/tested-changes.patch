+for (const length of args.cases ? args.cases.split(',') : ['short', 'long']) {
+  const cove = length === 'short' ? 'holding-pier' : 'bellwater';
+  const context = await browser.newContext({
+    viewport: { width, height },
+    deviceScaleFactor: 1,
+    hasTouch: width < 1000,
+    isMobile: width < 1000,
+    reducedMotion: 'no-preference',
+    ...(args.record === 'false'
