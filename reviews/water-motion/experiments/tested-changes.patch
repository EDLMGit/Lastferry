+import { expect, test } from 'vitest';
+import { ShaderMaterial, Vector3 } from 'three';
+import { holdingPier } from '../../src/levels/level';
+import { getLevelPaths } from '../../src/scene/paths';
+import { CoastalWater } from '../../src/scene/water';
+
+test('localized water interaction accepts horizontal travel only and clears invalid or cancelled input', () => {
+  const water = new CoastalWater(holdingPier, getLevelPaths(holdingPier));
+  const ordinary = water.presentation();
+  water.update(0.36, 12);
+  water.setHarbor(new Vector3(-5, 3, -4), 0.6);
+  expect(water.presentation().boat.strength).toBe(0);
+  water.setBoatInteraction(new Vector3(3, 20, -4), new Vector3(3, 50, 4), 1.5);
+  expect(water.presentation().boat).toEqual({
+    position: [3, -4],
+    direction: [0.6, 0.8],
+    strength: 1,
+    response: 1,
+  });
+  water.setBoatInteraction(new Vector3(3, -20, -4), new Vector3(0, 5, 0), 1);
+  expect(water.presentation().boat).toEqual({
+    position: [0, 0],
+    direction: [0, 1],
+    strength: 0,
+    response: 1,
+  });
+  water.setBoatInteraction(new Vector3(3, 0, -4), new Vector3(-3, 0, -4), -1);
+  expect(water.presentation().boat.strength).toBe(0);
+  water.setBoatInteraction(new Vector3(Infinity, 0, 0), new Vector3(1, 0, 0), 1);
+  expect(water.presentation().boat.position).toEqual([0, 0]);
+  water.setBoatInteraction(new Vector3(3, 0, -4), new Vector3(1, 0, 0), Number.NaN);
+  expect(water.presentation().boat.strength).toBe(0);
+  expect(water.presentation().tuning).toEqual(ordinary.tuning);
+  expect(water.presentation().arrival).toBe(0.6);
+  water.dispose();
+});
+
+test('water interaction reuses uniforms and resources across direction, tide, comparison and reset changes', () => {
+  const water = new CoastalWater(holdingPier, getLevelPaths(holdingPier));
+  const material = water.mesh.material as ShaderMaterial;
+  const resources = [water.mesh.geometry, material, water.mask.texture, water.seabed.texture];
+  const position = material.uniforms.boatPosition.value,
+    direction = material.uniforms.boatDirection.value,
+    uniformCount = Object.keys(material.uniforms).length,
+    version = material.version;
+  water.configureBoatResponse(0.5);
+  for (let cycle = 0; cycle < 12; cycle++) {
+    water.setBoatInteraction(new Vector3(cycle, cycle * 0.18, 2), new Vector3(-1, 0, 1), 0.7);
+    water.update((cycle % 3) * 0.18, cycle);
+    expect(water.presentation().boat.direction[0]).toBeCloseTo(-Math.SQRT1_2);
+    water.clearBoatInteraction();
+    expect(water.presentation().boat.strength).toBe(0);
+    expect(water.presentation().boat.response).toBe(0.5);
+    expect(material.uniforms.boatPosition.value).toBe(position);
+    expect(material.uniforms.boatDirection.value).toBe(direction);
+    expect([water.mesh.geometry, material, water.mask.texture, water.seabed.texture]).toEqual(
+      resources,
+    );
+    expect(Object.keys(material.uniforms)).toHaveLength(uniformCount);
+    expect(material.version).toBe(version);
+  }
+  water.configureBoatResponse(-1);
+  expect(water.presentation().boat.response).toBe(0);
+  water.configureBoatResponse(Number.NaN);
+  expect(water.presentation().boat.response).toBe(0);
+  water.configureBoatResponse(2);
+  expect(water.presentation().boat.response).toBe(1);
+  expect(water.presentation().renderPasses).toBe(1);
+  expect(water.presentation().reflectionTargets).toBe(0);
+  water.dispose();
+});
