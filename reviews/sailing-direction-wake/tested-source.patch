+        after: 0.03,
+        water: 0,
+        tide: 0,
+      },
+      {
+        name: 'holding-board',
+        board: true,
+        ids: [2],
+        pierY: 0.54,
+        width: 0.8,
+        before: -0.045,
+        after: -0.12,
+        water: 0.18,
+        tide: 0,
+      },
+      {
+        name: 'rabbit-boundary',
+        board: true,
+        ids: [0, 1],
+        pierY: 0.18,
+        width: 0.9,
+        before: 0.03,
+        after: -0.045,
+        water: 0,
+        tide: 0.18,
+      },
+      {
+        name: 'harbor-unload',
+        board: false,
+        ids: [0, 1, 2],
+        pierY: 0.54,
+        width: 0.6,
+        before: -0.12,
+        after: 0.03,
+        water: 0.36,
+        tide: 0,
+      },
+    ]) {
+      for (const id of scenario.ids) {
+        const anchor = new Vector3(
+            ...([
+              [-0.22, 0.26, firstRabbitDeckZ],
+              [0.22, 0.26, 0.3],
+              [0, 0.26, 0.69],
+            ][id] as [number, number, number]),
+          ),
+          offset = id === 2 ? 0 : id === 0 ? -0.07 : 0.07,
+          bridge = new Vector3(
+            MathUtils.clamp(
+              Math.sin(heading) * bridgeBowOffset + offset,
+              -scenario.width / 2,
+              scenario.width / 2,
+            ),
+            scenario.pierY - 0.005,
+            -0.44,
+          ),
+          land = new Vector3(offset, scenario.pierY + 0.025, -1.95),
+          waiting = new Vector3(
+            id === 2 ? 0 : id === 0 ? -0.21 : 0.21,
+            scenario.pierY - 0.005,
+            -1.02,
+          ),
+          initial = anchor
+            .clone()
+            .applyAxisAngle(axis, heading)
+            .add(new Vector3(0, scenario.water + scenario.before, 0));
+        expect(Math.abs(bridge.x)).toBeLessThanOrEqual(scenario.width / 2);
+        for (let i = 0; i <= 100; i++) {
+          const t = i / 100,
+            k = smooth(t),
+            duration = scenario.name === 'harbor-unload' ? 900 : 520,
+            settled = smooth(
