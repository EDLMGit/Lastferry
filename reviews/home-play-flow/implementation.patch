diff --git a/src/campaign/story.css b/src/campaign/story.css
index 8480f20..5b37c72 100644
--- a/src/campaign/story.css
+++ b/src/campaign/story.css
@@ -303,3 +303,87 @@
     padding-inline: 9px;
   }
 }
+
+.story-controls {
+  grid-template-columns: minmax(38px, 1fr) auto auto auto minmax(150px, auto);
+}
+#story-pause,
+#story-sound,
+#story-more,
+#story-continue {
+  grid-row: 1;
+}
+#story-pause {
+  grid-column: 2;
+}
+#story-sound {
+  grid-column: 3;
+}
+#story-more {
+  grid-column: 4;
+  position: relative;
+}
+#story-continue {
+  grid-column: 5;
+}
+#story-more summary {
+  min-height: 46px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 8px 14px;
+  border: 1px solid #b6a478;
+  border-radius: 18px;
+  cursor: pointer;
+  font-size: 14px;
+}
+#story-more summary:focus-visible {
+  outline: 3px solid #ffe09a;
+  outline-offset: 3px;
+}
+.story-secondary {
+  position: absolute;
+  z-index: 2;
+  bottom: calc(100% + 10px);
+  right: 0;
+  display: grid;
+  gap: 7px;
+  padding: 12px;
+  width: 180px;
+  background: #173e46;
+  border: 1px solid #cab586;
+  border-radius: 18px;
+  box-shadow: 0 4px 20px #08262b80;
+}
+.story-secondary > button {
+  grid-column: auto !important;
+  grid-row: auto !important;
+}
+@media (max-width: 599px) {
+  .story-controls {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+  #story-position {
+    grid-row: 1;
+    grid-column: 1;
+  }
+  #story-pause {
+    grid-row: 2;
+    grid-column: 1;
+  }
+  #story-sound {
+    grid-row: 2;
+    grid-column: 2;
+  }
+  #story-more {
+    grid-row: 2;
+    grid-column: 3;
+  }
+  #story-continue {
+    grid-row: 3;
+    grid-column: 1 / -1;
+  }
+  #story-captions {
+    min-height: 125px;
+  }
+}
