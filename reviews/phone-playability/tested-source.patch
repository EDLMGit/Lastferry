+        const r = e.getBoundingClientRect();
+        return (
+          !e.closest('.offscreen') &&
+          getComputedStyle(e).opacity !== '0' &&
+          r.left >= 0 &&
+          r.top >= 0 &&
+          r.right <= innerWidth &&
+          r.bottom <= innerHeight
