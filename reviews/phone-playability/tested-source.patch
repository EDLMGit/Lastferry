+        const r = e.getBoundingClientRect();
+        return {
+          left: r.left,
+          top: r.top,
+          right: r.right,
+          bottom: r.bottom,
+          width: r.width,
+          height: r.height,
+        };
+      };
+      const frame = api.getFrameStatus(),
+        boat = frame.boat;
+      return {
+        state: api.getState(),
+        render: api.getRenderStatus(),
+        frame,
+        ferryDimensions: { width: boat.right - boat.left, height: boat.bottom - boat.top },
+        visibleViewport: {
+          width: innerWidth,
+          height: innerHeight,
+          visual: visualViewport
+            ? {
