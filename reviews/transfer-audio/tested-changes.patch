+    expect((await audio(page)).deliveryCount).toBe(1);
+    await page.waitForFunction(
+      () => (window as any).__LAST_FERRY__.getAudioStatus().transferSources === 0,
+    );
+    await stableClock(page);
+  } finally {
+    await save(page, 'lifecycle-transfers');
+  }
+});
